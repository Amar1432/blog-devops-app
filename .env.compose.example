# Docker Compose environment template for the DevOps Blog.
#
#   cp .env.compose.example .env.compose
#   # edit every placeholder, then run:
#   docker compose --env-file .env.compose <command>
#
# .env.compose is gitignored. Never commit real credentials.
#
# The POSTGRES_PASSWORD appears twice: once for the database container and
# once inside DATABASE_URL. Keep them identical. If the password contains
# characters such as @ : / ? # %, URL-encode them in DATABASE_URL.

# --- PostgreSQL container -------------------------------------------------
POSTGRES_USER=devops
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=devops_blog

# --- Backend runtime ------------------------------------------------------
NODE_ENV=production
# Internal container port. Keep 5000; the API health check probes it.
PORT=5000
# Host `db` is the Compose service name. Never use localhost here: inside the
# API container, localhost is the API container itself.
DATABASE_URL=postgresql://devops:replace-with-a-long-random-password@db:5432/devops_blog?schema=public
# At least 16 characters; use a long random value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=1d
# Must include the exact frontend origin used in the browser.
CORS_ORIGIN=http://localhost:8080
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
# Minimum 8 characters. Used only by the seed script.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- Frontend (build time) ------------------------------------------------
# Baked into the Vite bundle when the web image is built. Changing it requires
# rebuilding the web image (`docker compose build web`). It must be the
# host-published API URL, not the `api` service name.
VITE_API_URL=http://localhost:5001/api

# --- Host port overrides --------------------------------------------------
# Container ports stay fixed (80, 5000, 5432); only host-side mappings change.
WEB_HOST_PORT=8080
API_HOST_PORT=5001
DB_HOST_PORT=5433

# --- Monitoring overrides -------------------------------------------------
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
NODE_EXPORTER_HOST_PORT=9100
POSTGRES_EXPORTER_HOST_PORT=9187
