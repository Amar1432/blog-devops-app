{
  "name": "devops-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:api": "eslint apps/api",
    "lint:web": "eslint apps/web",
    "dev": "npm run dev --workspace=@devops-blog/api & npm run dev --workspace=@devops-blog/web",
    "dev:api": "npm run dev --workspace=@devops-blog/api",
    "dev:web": "npm run dev --workspace=@devops-blog/web",
    "build": "npm run build --workspace=@devops-blog/web",
    "start": "npm run start --workspace=@devops-blog/api",
    "test": "npm run test:web && npm run test --workspace=@devops-blog/api",
    "test:unit": "npm run test:unit --workspace=@devops-blog/api",
    "test:component": "npm run test:component --workspace=@devops-blog/api",
    "test:integration": "npm run test:integration --workspace=@devops-blog/api",
    "test:api": "npm run test:api --workspace=@devops-blog/api",
    "test:e2e": "npm run test:e2e --workspace=@devops-blog/api",
    "test:web": "npm run test --workspace=@devops-blog/web",
    "test:coverage": "npm run test:coverage --workspace=@devops-blog/api",
    "db:generate": "npm run db:generate --workspace=@devops-blog/api",
    "db:migrate": "npm run db:migrate --workspace=@devops-blog/api",
    "db:deploy": "npm run db:deploy --workspace=@devops-blog/api",
    "db:seed": "npm run db:seed --workspace=@devops-blog/api",
    "db:studio": "npm run db:studio --workspace=@devops-blog/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0"
  }
}
