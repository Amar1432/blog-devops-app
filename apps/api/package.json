    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^6.5.0",
    "supertest": "^7.3.1"
