# Dedicated test database. The suite refuses to run against a database
# whose name does not end in "_test".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devops_blog_test?schema=public"

NODE_ENV=test
PORT=4001
CORS_ORIGIN="http://localhost:5173"

# Test-only signing secret. Never reuse this outside tests.
JWT_SECRET="test-only-secret-at-least-16-characters"
JWT_EXPIRES_IN="1h"

ADMIN_EMAIL="admin@test.local"
ADMIN_PASSWORD="test-password"
ADMIN_NAME="Test Admin"
