{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API Request Rate & Health (RED Method)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"devops-blog-api\"}[1m]))",
          "legendFormat": "Total Throughput",
          "refId": "A"
        }
      ],
      "title": "Total Request Rate (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{app=\"devops-blog-api\", status_code=~\"5..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total{app=\"devops-blog-api\"}[1m])) > 0) * 100",
          "legendFormat": "5xx Error Rate (%)",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(http_requests_total{app=\"devops-blog-api\", status_code=~\"4..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total{app=\"devops-blog-api\"}[1m])) > 0) * 100",
          "legendFormat": "4xx Client Error Rate (%)",
          "refId": "B"
        }
      ],
      "title": "Error Rates (% of Total)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=\"devops-blog-api\"}[1m])) by (le))",
          "legendFormat": "p99 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"devops-blog-api\"}[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=\"devops-blog-api\"}[1m])) by (le))",
          "legendFormat": "p50 (Median) Latency",
          "refId": "C"
        }
      ],
      "title": "Request Duration Percentiles",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Route Breakdown & In-Flight Concurrency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "stacking": { "group": "A", "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"devops-blog-api\"}[1m])) by (route, status_code)",
          "legendFormat": "{{route}} [{{status_code}}]",
          "refId": "A"
        }
      ],
      "title": "Requests by Endpoint & Status Code",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        {
          "expr": "http_active_requests{app=\"devops-blog-api\"}",
          "legendFormat": "In-Flight Requests",
          "refId": "A"
        }
      ],
      "title": "Active In-Flight Requests",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "Node.js Process & Runtime Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{app=\"devops-blog-api\"}",
          "legendFormat": "RSS Memory",
          "refId": "A"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{app=\"devops-blog-api\"}",
          "legendFormat": "Heap Total",
          "refId": "B"
        },
        {
          "expr": "nodejs_heap_size_used_bytes{app=\"devops-blog-api\"}",
          "legendFormat": "Heap Used",
          "refId": "C"
        }
      ],
      "title": "Node.js Process Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{app=\"devops-blog-api\"}",
          "legendFormat": "Event Loop Lag (p99)",
          "refId": "A"
        },
        {
          "expr": "nodejs_eventloop_lag_mean_seconds{app=\"devops-blog-api\"}",
          "legendFormat": "Event Loop Lag (Mean)",
          "refId": "B"
        }
      ],
      "title": "Event Loop Lag",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["devops-blog", "express", "api", "red"],
  "time": { "from": "now-15m", "to": "now" },
