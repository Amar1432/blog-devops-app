# -----------------------------------------------------------------------------
# Production Environment Variables (.env)
# Copy to .env on the server (/opt/devops-blog/.env) and fill in real values.
# NEVER commit the real .env file or credentials to version control.
# -----------------------------------------------------------------------------

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=devops_blog_user
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here
POSTGRES_DB=devops_blog_prod

# --- Security & Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_secure_jwt_secret_at_least_16_characters_long
JWT_EXPIRES_IN=1d

# --- CORS & Networking ---
# Comma-separated list of allowed origins. Must match the public frontend URL(s).
# E.g. http://129.154.253.114:8080 or your domain.
CORS_ORIGIN=http://129.154.253.114:8080,http://localhost:8080

# --- Frontend Build/Runtime API Target ---
# The public API URL accessible by browsers over the network.
# E.g. http://129.154.253.114:5000/api
VITE_API_URL=http://129.154.253.114:5000/api

# --- Initial Admin User (for seeding) ---
ADMIN_NAME=DevOps Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password_min_8_chars

# --- Published Host Ports ---
API_HOST_PORT=5000
WEB_HOST_PORT=8080
